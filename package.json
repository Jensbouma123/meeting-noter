{
  "name": "meeting-noter",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:next": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:update-e2e": "node scripts/installer/update-e2e.mjs",
    "helper:build": "sh helper/build.sh",
    "helper": "sh helper/build.sh && ./helper/build/meeting-noter-audio-helper",
    "app": "node scripts/dev.mjs --prod",
    "helper:install": "sh helper/install-agent.sh",
    "helper:uninstall": "sh helper/install-agent.sh uninstall",
    "mcp:build": "rolldown -c scripts/mcp/rolldown.config.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@jensbouma123/acciva-ui": "file:vendor/acciva-ui",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "lucide-react": "^1.61.0",
    "next": "16.3.6",
    "onnxruntime-web": "1.24.1",
    "parakeet.js": "1.4.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "simple-icons": "^16.37.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.2.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "rolldown": "1.2.19",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT",
  "description": "On-device, browser-native meeting transcription (ASR, diarization, language ID)."
}
