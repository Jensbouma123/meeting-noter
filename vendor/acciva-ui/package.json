{
  "name": "@jensbouma123/acciva-ui",
  "version": "0.17.11",
  "description": "Agent-first component library, logger, and API client layers.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "bin": {
    "acciva": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "skills",
    "eslint-rules"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jensbouma123/acciva-ui.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ui/*": {
      "types": "./dist/components/ui/*/index.d.ts",
      "import": "./dist/components/ui/*/index.js",
      "default": "./dist/components/ui/*/index.js"
    },
    "./blocks/*": {
      "types": "./dist/components/blocks/*/index.d.ts",
      "import": "./dist/components/blocks/*/index.js",
      "default": "./dist/components/blocks/*/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js",
      "default": "./dist/theme/index.js"
    },
    "./color": {
      "types": "./dist/lib/color/index.d.ts",
      "import": "./dist/lib/color/index.js",
      "default": "./dist/lib/color/index.js"
    },
    "./image": {
      "types": "./dist/lib/image/index.d.ts",
      "import": "./dist/lib/image/index.js",
      "default": "./dist/lib/image/index.js"
    },
    "./logger": {
      "types": "./dist/logger/index.d.ts",
      "import": "./dist/logger/index.js",
      "default": "./dist/logger/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js",
      "default": "./dist/api/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "import": "./dist/next/index.js",
      "default": "./dist/next/index.js"
    },
    "./styles": "./dist/styles/tokens.css",
    "./styles/base": "./dist/styles/base.css",
    "./eslint-rules": "./eslint-rules/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "validate:specs": "node scripts/validate-specs.ts && node scripts/check-skill-sync.ts",
    "specs:check": "node scripts/validate-specs.ts",
    "check:file-length": "node scripts/check-file-length.ts",
    "check:gallery": "node scripts/check-gallery-sync.ts",
    "tokens:generate": "node scripts/generate-tokens.ts",
    "tokens:contrast": "node scripts/audit-token-contrast.ts",
    "verify:safelist": "node scripts/generate-size-safelist.mjs --check",
    "audit:a11y": "node scripts/audit-a11y.ts",
    "test": "vitest run --configLoader runner",
    "test:unit": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "test:a11y": "playwright test",
    "test:e2e": "playwright test",
    "test:lighthouse": "lhci autorun --config=./lighthouserc.cjs",
    "audit:lighthouse": "lhci autorun --config=./lighthouserc.cjs",
    "build:lib": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && node src/cli/fix-dist-imports.mjs dist && node scripts/emit-subpath-shims.mjs dist && mkdir -p dist/styles && cp src/styles/tokens.css dist/styles/tokens.css && cp src/styles/base.css dist/styles/base.css && cp -R src/styles/base dist/styles/ && chmod +x dist/cli/index.js && node scripts/build-registry.ts && node scripts/check-no-position-try.mjs dist/styles",
    "publish:local": "npm run build:lib && npx yalc publish --push",
    "prepack": "npm run build:lib",
    "prepublishOnly": "npm run build:lib",
    "verify:static": "node scripts/verify-static.mjs",
    "verify:all": "npm run verify:static && next build && npm run build:lib && npm run size && npm run test && npm run test:a11y && npm run test:lighthouse",
    "size": "node scripts/check-bundle.mjs"
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "peerDependencies": {
    "lucide-react": "^1.61.0",
    "next": "^16",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4",
    "tsc-alias": "^1.9.9",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
